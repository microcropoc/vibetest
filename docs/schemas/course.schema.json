{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibetest.app/schemas/course.schema.json",
  "title": "VibeTest Course",
  "description": "Канонический курс в IndexedDB: с courseId, moduleId, stepId (UUID v4) и createdAt. Для импорта авторов без UUID используй course-import.schema.json. Семантика шагов — в description у $defs и полей.",
  "type": "object",
  "required": ["schemaVersion", "courseId", "createdAt", "title", "description", "modules"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Версия формата документа. Для текущих курсов всегда 1."
    },
    "courseId": { "$ref": "#/$defs/uuid" },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Момент создания/импорта курса (ISO 8601). В import-DTO отсутствует."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Название курса (отображается в списке курсов)."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Краткое описание курса для ученика."
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "description": "Упорядоченный список модулей курса.",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUID версии 4 (нижний регистр hex). В каноническом курсе — courseId, moduleId, stepId; в import-DTO этих полей нет."
    },
    "module": {
      "type": "object",
      "description": "Модуль — логическая часть курса с собственным списком шагов.",
      "required": ["moduleId", "title", "steps"],
      "additionalProperties": false,
      "properties": {
        "moduleId": { "$ref": "#/$defs/uuid" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Название модуля."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "description": "Упорядоченные шаги модуля; тип content зависит от type каждого шага.",
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "description": "Один шаг модуля: type определяет форму content (см. allOf/if/then).",
      "required": ["stepId", "type", "title", "content"],
      "additionalProperties": false,
      "properties": {
        "stepId": { "$ref": "#/$defs/uuid" },
        "type": {
          "type": "string",
          "enum": ["theory", "svg", "quiz", "javascript", "sqlite", "regex"],
          "description": "Тип шага: theory — Markdown-теория (строка content); svg — inline SVG (объект); quiz — тест с вариантами; javascript — JS-практика с dual-run проверкой; sqlite — SQL-практика в sql.js; regex — практика с RegExp.test. content обязан соответствовать выбранному type."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Заголовок шага в плеере."
        },
        "content": true
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "theory" } } }, "then": { "properties": { "content": { "$ref": "#/$defs/theoryContent" } } } },
        { "if": { "properties": { "type": { "const": "svg" } } }, "then": { "properties": { "content": { "$ref": "#/$defs/svgContent" } } } },
        { "if": { "properties": { "type": { "const": "quiz" } } }, "then": { "properties": { "content": { "$ref": "#/$defs/quizContent" } } } },
        { "if": { "properties": { "type": { "const": "javascript" } } }, "then": { "properties": { "content": { "$ref": "#/$defs/javascriptContent" } } } },
        { "if": { "properties": { "type": { "const": "sqlite" } } }, "then": { "properties": { "content": { "$ref": "#/$defs/sqliteContent" } } } },
        { "if": { "properties": { "type": { "const": "regex" } } }, "then": { "properties": { "content": { "$ref": "#/$defs/regexContent" } } } }
      ]
    },
    "theoryContent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "description": "Markdown-текст теории. Многострочный код — только в fenced-блоках с указанием языка (например ```javascript). Короткие фрагменты — inline code. Без автопроверки; достаточно прочитать."
    },
    "svgContent": {
      "type": "object",
      "description": "Inline SVG (SMIL/CSS допустимы); рендер без санитизации. Без автопроверки.",
      "required": ["svg"],
      "additionalProperties": false,
      "properties": {
        "svg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000,
          "description": "Полный фрагмент SVG (корневой элемент <svg …>)."
        },
        "caption": {
          "type": "string",
          "maxLength": 300,
          "description": "Необязательная подпись над рисунком."
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Необязательное пояснение под рисунком."
        }
      }
    },
    "quizContent": {
      "type": "object",
      "description": "Локальная проверка ответа; успех переводит шаг в completed.",
      "required": ["question", "options", "correctIndices"],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Текст вопроса."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "description": "Варианты ответа; индексация с 0.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Текст одного варианта."
          }
        },
        "correctIndices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "description": "Индексы правильных вариантов в options (0-based). Каждый индекс строго меньше options.length. Один индекс — один ответ (radio); несколько — множественный выбор (checkbox).",
          "items": {
            "type": "integer",
            "minimum": 0,
            "description": "Индекс элемента в массиве options."
          }
        }
      }
    },
    "javascriptContent": {
      "type": "object",
      "description": "JS-практика: код ученика и эталон выполняются в двух изолированных средах (dual-run); результаты сравниваются JSON-equal. Порядок на тест-кейс: reset → вызов functionName(...args) → цепочка calls → await thenable при необходимости → rejects → flushMicrotasks → advanceMs → expectInvocations.",
      "required": ["description", "starterCode", "referenceSolution", "setup", "functionName", "timeoutMs", "tests"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Условие задачи для ученика (Markdown/plain text)."
        },
        "starterCode": {
          "type": "string",
          "maxLength": 20000,
          "description": "Начальный код в редакторе (может быть пустой строкой)."
        },
        "referenceSolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Эталонное решение; должно проходить все tests в reference-среде."
        },
        "setup": {
          "type": "string",
          "maxLength": 20000,
          "description": "JS подготовки среды перед загрузкой starterCode/referenceSolution в обеих средах (моки, registerSpy); не класть проверочные данные в setup — functionName появляется после load кода."
        },
        "reset": {
          "type": "string",
          "maxLength": 20000,
          "description": "Необязательный JS перед каждым тест-кейсом для сброса состояния между кейсами."
        },
        "functionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Имя вызываемой функции; должна существовать после загрузки starterCode/referenceSolution в среде."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "description": "Лимит времени на весь шаг практики (мс)."
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "description": "Набор тест-кейсов; каждый прогоняется для user и reference кода.",
          "items": {
            "type": "object",
            "description": "Один тест-кейс JS-практики.",
            "required": ["args"],
            "additionalProperties": false,
            "properties": {
              "args": {
                "type": "array",
                "maxItems": 20,
                "description": "Аргументы первого вызова functionName(...args); значения должны быть JSON-serializable для сравнения."
              },
              "calls": {
                "type": "array",
                "minItems": 0,
                "maxItems": 20,
                "description": "Дополнительные вызовы functionName или method(...args) после первого invoke.",
                "items": {
                  "type": "object",
                  "required": ["args"],
                  "additionalProperties": false,
                  "properties": {
                    "args": {
                      "type": "array",
                      "maxItems": 20,
                      "description": "Аргументы вызова."
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "description": "Если задан — current[method](...args) на результате предыдущего шага; иначе current(...args) (результат должен быть callable)."
                    }
                  }
                }
              },
              "rejects": {
                "type": "boolean",
                "description": "true: и user, и reference должны завершиться reject; reason: для Error — message; иначе JSON-equal как у fulfill."
              },
              "expectInvocations": {
                "type": "object",
                "description": "Ожидаемое число вызовов spy по имени (ключ — имя spy, значение — count).",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "advanceMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000,
                "description": "Продвинуть fake timers на столько мс в обеих средах перед финальным сравнением."
              },
              "flushMicrotasks": {
                "type": "boolean",
                "description": "true: drain microtasks queue в обеих средах перед сравнением."
              }
            }
          }
        }
      }
    },
    "sqliteContent": {
      "type": "object",
      "description": "SQL-практика в sql.js: ученик пишет запрос; результат сравнивается с эталоном. setup — DDL (CREATE TABLE); начальные данные только в tests[].seed; reset не должен содержать INSERT/seed-DML.",
      "required": ["description", "starterCode", "referenceSolution", "setup", "orderMatters", "timeoutMs", "tests"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Условие задачи для ученика."
        },
        "starterCode": {
          "type": "string",
          "maxLength": 20000,
          "description": "Начальный SQL в редакторе."
        },
        "referenceSolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Эталонный SQL-запрос."
        },
        "setup": {
          "type": "string",
          "maxLength": 20000,
          "description": "DDL и прочий SQL без seed-DML (CREATE TABLE и т.п.)."
        },
        "reset": {
          "type": "string",
          "maxLength": 20000,
          "description": "SQL между тест-кейсами; без INSERT INTO seed-данных (seed только в tests[].seed)."
        },
        "orderMatters": {
          "type": "boolean",
          "description": "true: порядок строк в результате SELECT важен при сравнении."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "description": "Лимит времени на шаг (мс)."
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "description": "Тест-кейсы с отдельным seed-DML на каждый.",
          "items": {
            "type": "object",
            "required": ["seed"],
            "additionalProperties": false,
            "properties": {
              "seed": {
                "type": "string",
                "maxLength": 5000,
                "description": "DML (INSERT и т.п.) для наполнения БД перед прогоном этого кейса."
              }
            }
          }
        }
      }
    },
    "regexContent": {
      "type": "object",
      "description": "Практика regex: starterCode и referenceSolution — строки паттернов; для каждого tests[].input сравнивается boolean RegExp.test(input) у ученика и эталона.",
      "required": ["description", "starterCode", "referenceSolution", "timeoutMs", "tests"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "Условие задачи для ученика."
        },
        "starterCode": {
          "type": "string",
          "maxLength": 2000,
          "description": "Начальный паттерн (строка для RegExp)."
        },
        "referenceSolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Эталонный паттерн."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "description": "Лимит времени на шаг (мс)."
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "description": "Входные строки для проверки .test().",
          "items": {
            "type": "object",
            "required": ["input"],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "string",
                "maxLength": 2000,
                "description": "Строка, передаваемая в RegExp.test."
              }
            }
          }
        }
      }
    }
  }
}
