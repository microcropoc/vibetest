    {
      "type": "javascript",
      "title": "Subtree of Another Tree",
      "content": {
        "description": "Дерево `subRoot` — поддерево `root`? [LeetCode 572. Subtree of Another Tree](https://leetcode.com/problems/subtree-of-another-tree/)",
        "starterCode": "function isSubtree(root, subRoot) {\n  return false;\n}",
        "referenceSolution": "function isSubtree(root, subRoot) {\n  const same = (a, b) => {\n    if (!a && !b) return true;\n    if (!a || !b || a.val !== b.val) return false;\n    return same(a.left, b.left) && same(a.right, b.right);\n  };\n  if (!root) return false;\n  if (same(root, subRoot)) return true;\n  return isSubtree(root.left, subRoot) || isSubtree(root.right, subRoot);\n}",
        "setup": "",
        "reset": "",
        "functionName": "isSubtree",
        "timeoutMs": 8000,
        "tests": [
