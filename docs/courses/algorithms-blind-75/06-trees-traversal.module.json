    {
      "type": "javascript",
      "title": "Binary Tree Level Order Traversal",
      "content": {
        "description": "Обход по уровням: массив массивов значений слева направо. [LeetCode 102. Binary Tree Level Order Traversal](https://leetcode.com/problems/binary-tree-level-order-traversal/)",
        "starterCode": "function levelOrder(root) {\n  return [];\n}",
        "referenceSolution": "function levelOrder(root) {\n  if (!root) return [];\n  const out = [];\n  const q = [root];\n  while (q.length) {\n    const level = [];\n    const size = q.length;\n    for (let i = 0; i < size; i += 1) {\n      const node = q.shift();\n      level.push(node.val);\n      if (node.left) q.push(node.left);\n      if (node.right) q.push(node.right);\n    }\n    out.push(level);\n  }\n  return out;\n}",
        "setup": "",
        "reset": "",
        "functionName": "levelOrder",
        "timeoutMs": 8000,
        "tests": [
